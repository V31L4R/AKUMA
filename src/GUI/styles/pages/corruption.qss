/* Главный переключатель корруптора. */
QPushButton#corruption_switch {
    background-color: transparent;
    color: white;

    border: 1px solid #777777;
    border-radius: 4px;
}

/* Наведение на выключенный переключатель. */
QPushButton#corruption_switch:hover {
    background-color: #4a4a4a;
}

/* Включённый переключатель. */
QPushButton#corruption_switch:checked {
    background-color: white;
    color: black;
    border: 1px solid white;
}

/* Наведение на включённый переключатель. */
QPushButton#corruption_switch:checked:hover {
    background-color: white;
    color: black;
    border: 1px solid white;
}

QPushButton#exclusive_switch {
    background-color: #202020;
    color: #ffffff;
    border: 1px solid #606060;
    border-radius: 6px;
}

QPushButton#exclusive_switch:checked {
    background-color: #ffffff;
    color: #202020;
}

QPushButton#exclusive_switch:disabled {
    background-color: #505050;
    color: #808080;
    border: 1px solid #606060;
}